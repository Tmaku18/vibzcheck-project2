rules_version = '2';

// Vibzcheck Firestore security rules.
//
// Access model:
//   * All reads/writes require a signed-in Firebase Auth user.
//   * A session's root document stores `ownerId` and `memberIds: [uid, ...]`,
//     which are what every subcollection rule uses to decide access. Keeping
//     this on the root doc means a single `get()` per request instead of an
//     `exists()` roundtrip into the `members` subcollection.
//   * Session creation is self-authored: the owner's uid must appear in
//     both `ownerId` and the initial `memberIds` array.
//   * Queue vote updates happen inside a client-side Firestore transaction
//     (see `QueueRepository.castVote`). These rules only enforce that the
//     caller is already a session member; per-field vote validation lands
//     in Phase 4 hardening.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function sessionData(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    function isSessionOwner(sessionId) {
      return isSignedIn() && sessionData(sessionId).ownerId == request.auth.uid;
    }

    function isSessionMember(sessionId) {
      return isSignedIn()
        && request.auth.uid in sessionData(sessionId).memberIds;
    }

    // True when the only thing this update does is add the caller's own uid
    // to `memberIds` (and bump the denormalised counters/timestamps that
    // accompany it). Lets non-members "join by code" without granting them
    // permission to mutate any other field of the session document.
    function isJoiningSelf() {
      return isSignedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds', 'memberCount', 'updatedAt']);
    }

    // ---------------- joinCodes/{code} ----------------
    // Tiny mapping doc keyed by the 6-char join code so non-members can
    // resolve a code to its sessionId without us having to expose the full
    // sessions collection to enumeration. Holds nothing sensitive (only
    // sessionId + ownerId), and is created in the same batch as the session
    // itself so the two never drift.
    match /joinCodes/{code} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    // ---------------- users/{uid} ----------------
    match /users/{uid} {
      allow read:   if isSelf(uid);
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if false;
    }

    // ---------------- sessions/{sessionId} ----------------
    match /sessions/{sessionId} {
      // Members and owner can read the root session doc.
      allow read: if isSignedIn()
        && (request.auth.uid in resource.data.memberIds
            || resource.data.ownerId == request.auth.uid);

      // On create, caller must be the owner *and* include themselves in
      // memberIds so the initial member list is never empty or forged.
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      // Existing members and the owner can update freely. Non-members may
      // update *only* to add themselves on join (see `isJoiningSelf`).
      allow update: if isSignedIn()
        && (request.auth.uid in resource.data.memberIds
            || resource.data.ownerId == request.auth.uid
            || isJoiningSelf());

      allow delete: if isSessionOwner(sessionId);

      // ---------------- members/{uid} ----------------
      match /members/{memberUid} {
        allow read: if isSessionMember(sessionId) || isSessionOwner(sessionId);
        allow create: if isSelf(memberUid);
        allow update: if isSelf(memberUid);
        allow delete: if isSelf(memberUid) || isSessionOwner(sessionId);
      }

      // ---------------- queue/{trackId} ----------------
      match /queue/{trackId} {
        allow read: if isSessionMember(sessionId);
        allow create: if isSessionMember(sessionId)
          && request.resource.data.addedBy == request.auth.uid;
        allow update: if isSessionMember(sessionId);
        allow delete: if isSessionOwner(sessionId)
          || (isSessionMember(sessionId)
              && resource.data.addedBy == request.auth.uid);
      }

      // ---------------- messages/{messageId} ----------------
      match /messages/{messageId} {
        allow read: if isSessionMember(sessionId);
        allow create: if isSessionMember(sessionId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if false;
        allow delete: if isSessionOwner(sessionId);
      }

      // ---------------- suggestions/{snapshotId} ----------------
      // Written exclusively by Cloud Functions (Admin SDK bypasses rules).
      match /suggestions/{snapshotId} {
        allow read: if isSessionMember(sessionId);
        allow write: if false;
      }
    }
  }
}
